<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <title><%= etapa === "cadastro" ? "Cadastro" : "Entrar" %> — Steply (<%= tituloPerfil %>)</title>
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="stylesheet" href="/css/tablet.css" media="screen and (min-width: 768px) and (max-width: 1199px)">
    <link rel="stylesheet" href="/css/desktop.css" media="screen and (min-width: 1200px)">
</head>
<body>
    <main class="auth-page auth-page--<%= perfil %>-<%= etapa %>">
        <div class="auth-glow auth-glow--warm" aria-hidden="true"></div>
        <% if (etapa === "entrar") { %>
            <div class="auth-glow auth-glow--blue" aria-hidden="true"></div>
        <% } %>
        <a class="auth-back" href="/" aria-label="Voltar para a página inicial">
            <img src="/assets/autenticacao/voltar.jpg" alt="">
        </a>
        <h1 class="auth-title">Como <%= tituloPerfil %></h1>

        <section class="auth-card" aria-label="<%= etapa === 'cadastro' ? 'Cadastro' : 'Acesso' %> de <%= tituloPerfil.toLowerCase() %>">
            <nav class="auth-tabs" aria-label="Alternar entre entrar e cadastro">
                <a class="auth-tabs__link <%= etapa === 'entrar' ? 'is-active' : '' %>" href="<%= rotaEntrar %>" <%= etapa === "entrar" ? 'aria-current="page"' : '' %>>Entrar</a>
                <a class="auth-tabs__link <%= etapa === 'cadastro' ? 'is-active' : '' %>" href="<%= rotaCadastro %>" <%= etapa === "cadastro" ? 'aria-current="page"' : '' %>>Cadastre-se</a>
            </nav>

            <form class="auth-form <%= perfil === 'prestador' && etapa === 'cadastro' ? 'auth-form--provider' : '' %>" action="<%= etapa === 'cadastro' ? rotaCadastro : rotaEntrar %>" method="post" novalidate>
                <% if (perfil === "prestador" && etapa === "cadastro") { %>
                    <div class="provider-fields">
                        <% const providerSections = [
                            { className: "provider-field-group--identity", fields: [
                                { label: "Nome completo:", name: "nome", type: "text" },
                                { label: "Nome comercial:", name: "nome-comercial", type: "text" }
                            ] },
                            { className: "provider-field-group--email", fields: [
                                { label: "Insira o e-mail:", name: "email", type: "email" }
                            ] },
                            { className: "provider-field-group--passwords", fields: [
                                { label: "Senha:", name: "senha", type: "password" },
                                { label: "Confirmar Senha:", name: "confirmar-senha", type: "password" }
                            ] },
                            { className: "provider-field-group--address", fields: [
                                { label: "Estado:", name: "estado", type: "text", suggestions: true },
                                { label: "Cidade:", name: "cidade", type: "text", suggestions: true },
                                { label: "Bairro:", name: "bairro", type: "text", suggestions: true },
                                { label: "CEP:", name: "cep", type: "text" },
                                { label: "Rua:", name: "rua", type: "text" }
                            ] },
                            { className: "provider-field-group--split", fields: [
                                { label: "Número:", name: "numero", type: "text" },
                                { label: "Complemento:", name: "complemento", type: "text" }
                            ] },
                            { className: "provider-field-group--payment", fields: [
                                { label: "Data de Nascimento:", name: "nascimento", type: "text" },
                                { label: "CPF ou CNPJ:", name: "documento", type: "text" },
                                { label: "Telefone:", name: "telefone", type: "tel" },
                                { label: "Chave pix:", name: "pix", type: "text" }
                            ] },
                            { type: "uploads" },
                            { className: "provider-field-group--services", fields: [
                                { label: "Área de Atuação/Especialidade:", name: "especialidade", type: "text" },
                                { label: "Descrição/Biografia:", name: "biografia", type: "text" },
                                { label: "Comprovativo Formacional:", name: "formacao", type: "text" }
                            ] },
                            { type: "photo" },
                            { className: "provider-field-group--availability", fields: [
                                { label: "Modalidade de Atendimento:", name: "modalidade", type: "text" },
                                { label: "Raio de Atendimento:", name: "raio", type: "text" },
                                { label: "Horário de funcionamento:", name: "horario", type: "text" }
                            ] }
                        ]; %>
                        <% providerSections.forEach((section) => { %>
                            <% if (section.type === "uploads") { %>
                                <div class="provider-upload-label">Documento:</div>
                                <div class="provider-uploads">
                                    <label class="provider-upload provider-upload--front">
                                        <span>Frente:</span>
                                        <input type="file" name="documento-frente" aria-label="Enviar frente do documento">
                                        <i aria-hidden="true"></i>
                                    </label>
                                    <label class="provider-upload provider-upload--back">
                                        <span>Verso:</span>
                                        <input type="file" name="documento-verso" aria-label="Enviar verso do documento">
                                        <i aria-hidden="true"></i>
                                    </label>
                                </div>
                            <% } else if (section.type === "photo") { %>
                                <div class="provider-photo-section">
                                    <label class="provider-photo-label">
                                        Insira sua foto de perfil:
                                        <input type="file" name="foto-perfil" accept="image/*" aria-label="Enviar foto de perfil">
                                    </label>
                                    <img class="provider-photo" src="/assets/autenticacao/foto-perfil-padrao.png" alt="Imagem de perfil padrão">
                                </div>
                            <% } else { %>
                                <div class="provider-field-group <%= section.className %>">
                                    <% section.fields.forEach((field) => { %>
                                        <div class="provider-field">
                                            <label>
                                                <span><%= field.label %></span>
                                                <input
                                                    name="<%= field.name %>"
                                                    type="<%= field.type %>"
                                                    autocomplete="off"
                                                    value="<%= field.type === 'password' ? '' : (dados[field.name] || '') %>"
                                                    aria-invalid="<%= errosPorCampo?.[field.name] ? 'true' : 'false' %>"
                                                    <%= ['nome','nome-comercial','email','senha','confirmar-senha','estado','cidade','bairro','cep','rua','numero','nascimento','documento'].includes(field.name) ? 'required' : '' %>
                                                    <% if (field.name === 'nascimento') { %>placeholder="dd/mm/aaaa" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/[^0-9]/g,'').replace(/(\\d{2})(\\d)/,'$1/$2').replace(/(\\d{2})(\\d)/,'$1/$2')"<% } %>
                                                    <% if (field.name === 'documento') { %>placeholder="CPF ou CNPJ" maxlength="18" inputmode="numeric" oninput="let n=this.value.replace(/\\D/g,''); this.value=n.length<=11?n.replace(/(\\d{3})(\\d)/,'$1.$2').replace(/(\\d{3})(\\d)/,'$1.$2').replace(/(\\d{3})(\\d{1,2})$/,'$1-$2'):n.replace(/(\\d{2})(\\d)/,'$1.$2').replace(/(\\d{3})(\\d)/,'$1.$2').replace(/(\\d{3})(\\d)/,'$1/$2').replace(/(\\d{4})(\\d)/,'$1-$2')"<% } %>
                                                    <% if (field.name === 'cep') { %>maxlength="9" inputmode="numeric" oninput="this.value=this.value.replace(/\\D/g,'').replace(/(\\d{5})(\\d)/,'$1-$2')"<% } %>
                                                    <% if (field.name === 'telefone') { %>maxlength="15" inputmode="tel" oninput="this.value=this.value.replace(/\\D/g,'').replace(/^(\\d{2})(\\d)/,'($1) $2').replace(/(\\d{5})(\\d{4})$/,'$1-$2')"<% } %>
                                                    <% if (field.suggestions) { %>role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="provider-sugestoes-<%= field.name %>"<% } %>
                                                >
                                            </label>
                                            <% if (errosPorCampo?.[field.name]) { %>
                                                <small class="provider-field-error"><%= errosPorCampo[field.name] %></small>
                                            <% } %>
                                            <% if (field.suggestions) { %>
                                                <ul class="auth-suggestions provider-suggestions" id="provider-sugestoes-<%= field.name %>" role="listbox" hidden></ul>
                                            <% } %>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } %>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="auth-basic-fields">
                        <% if (etapa === "cadastro") { %>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">Nome completo</span>
                                    <input type="text" name="nome" placeholder="Nome completo:" autocomplete="name" maxlength="120" value="<%= dados.nome || '' %>" aria-invalid="<%= errosPorCampo?.nome ? 'true' : 'false' %>" required>
                                </label>
                                <% if (errosPorCampo?.nome) { %><small class="auth-field-error"><%= errosPorCampo.nome %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">Email</span>
                                    <input type="email" name="email" placeholder="Email:" autocomplete="email" value="<%= email %>" aria-invalid="<%= errosPorCampo?.email ? 'true' : 'false' %>" required>
                                </label>
                                <% if (errosPorCampo?.email) { %><small class="auth-field-error"><%= errosPorCampo.email %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">CPF</span>
                                    <input type="text" name="cpf" placeholder="CPF:" autocomplete="off" inputmode="numeric" maxlength="14" value="<%= dados.cpf || '' %>" aria-invalid="<%= errosPorCampo?.cpf ? 'true' : 'false' %>" oninput="this.value=this.value.replace(/\\D/g,'').replace(/(\\d{3})(\\d)/,'$1.$2').replace(/(\\d{3})(\\d)/,'$1.$2').replace(/(\\d{3})(\\d{1,2})$/,'$1-$2')" required>
                                </label>
                                <% if (errosPorCampo?.cpf) { %><small class="auth-field-error"><%= errosPorCampo.cpf %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">Data de nascimento</span>
                                    <input type="text" name="nascimento" placeholder="Data de nascimento (dd/mm/aaaa):" aria-label="Data de nascimento" autocomplete="bday" value="<%= dados.nascimento || '' %>" aria-invalid="<%= errosPorCampo?.nascimento ? 'true' : 'false' %>" required>
                                </label>
                                <% if (errosPorCampo?.nascimento) { %><small class="auth-field-error"><%= errosPorCampo.nascimento %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">Bairro</span>
                                    <input type="text" name="bairro" placeholder="Bairro:" autocomplete="address-level3" maxlength="100" value="<%= dados.bairro || '' %>" aria-invalid="<%= errosPorCampo?.bairro ? 'true' : 'false' %>" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sugestoes-bairros" required>
                                </label>
                                <ul class="auth-suggestions" id="sugestoes-bairros" role="listbox" hidden></ul>
                                <% if (errosPorCampo?.bairro) { %><small class="auth-field-error"><%= errosPorCampo.bairro %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">Cidade</span>
                                    <input type="text" name="cidade" placeholder="Cidade:" autocomplete="address-level2" maxlength="100" value="<%= dados.cidade || '' %>" aria-invalid="<%= errosPorCampo?.cidade ? 'true' : 'false' %>" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sugestoes-cidades" required>
                                </label>
                                <ul class="auth-suggestions" id="sugestoes-cidades" role="listbox" hidden></ul>
                                <% if (errosPorCampo?.cidade) { %><small class="auth-field-error"><%= errosPorCampo.cidade %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">CEP</span>
                                    <input type="text" name="cep" placeholder="CEP:" autocomplete="postal-code" maxlength="9" value="<%= dados.cep || '' %>" aria-invalid="<%= errosPorCampo?.cep ? 'true' : 'false' %>" oninput="this.value=this.value.replace(/\\D/g,'').replace(/(\\d{5})(\\d)/,'$1-$2')" required>
                                </label>
                                <% if (errosPorCampo?.cep) { %><small class="auth-field-error"><%= errosPorCampo.cep %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input">
                                    <span class="visually-hidden">Telefone</span>
                                    <input type="tel" name="telefone" placeholder="Telefone (opcional):" autocomplete="tel" inputmode="tel" maxlength="15" value="<%= dados.telefone || '' %>" aria-invalid="<%= errosPorCampo?.telefone ? 'true' : 'false' %>" oninput="this.value=this.value.replace(/\\D/g,'').replace(/^(\\d{2})(\\d)/,'($1) $2').replace(/(\\d{5})(\\d{4})$/,'$1-$2')">
                                </label>
                                <% if (errosPorCampo?.telefone) { %><small class="auth-field-error"><%= errosPorCampo.telefone %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input auth-input--password">
                                    <span class="visually-hidden">Senha</span>
                                    <input type="password" name="senha" placeholder="Senha:" autocomplete="new-password" aria-invalid="<%= errosPorCampo?.senha ? 'true' : 'false' %>" required>
                                </label>
                                <% if (errosPorCampo?.senha) { %><small class="auth-field-error"><%= errosPorCampo.senha %></small><% } %>
                            </div>
                            <div class="auth-field">
                                <label class="auth-input auth-input--confirm">
                                    <span class="visually-hidden">Confirmar senha</span>
                                    <input type="password" name="confirmar-senha" placeholder="Confirmar Senha:" autocomplete="new-password" aria-invalid="<%= errosPorCampo?.['confirmar-senha'] ? 'true' : 'false' %>" required>
                                </label>
                                <% if (errosPorCampo?.['confirmar-senha']) { %><small class="auth-field-error"><%= errosPorCampo['confirmar-senha'] %></small><% } %>
                            </div>
                        <% } else { %>
                            <label class="auth-input">
                                <span class="visually-hidden">Email</span>
                                <input type="<%= perfil === 'cliente' ? 'text' : 'email' %>" name="email" placeholder="<%= perfil === 'cliente' ? 'Email ou usuário:' : 'Email:' %>" autocomplete="<%= perfil === 'cliente' ? 'username' : 'email' %>" inputmode="email" value="<%= email %>" required>
                            </label>
                            <label class="auth-input auth-input--password">
                                <span class="visually-hidden">Senha</span>
                                <input type="password" name="senha" placeholder="Senha:" autocomplete="current-password" required>
                            </label>
                            <a class="auth-forgot" href="#mensagem">Esqueceu sua senha?</a>
                        <% } %>
                    </div>
                <% } %>
                <button class="auth-submit" type="submit"><%= etapa === "cadastro" ? "CRIAR" : "ENTRAR" %></button>
                <p class="auth-message <%= erro ? 'auth-message--error' : '' %>" id="mensagem" role="<%= erro ? 'alert' : 'status' %>" aria-live="polite"><%= mensagem %></p>
            </form>
        </section>

        <section class="auth-social" aria-label="Opções de acesso social">
            <div class="auth-social__divider"><span>Ou entre com</span></div>
            <div class="auth-social__icons" aria-label="Google, LinkedIn, Facebook e Apple">
                <span><img src="/assets/autenticacao/google.png" alt="Google"></span>
                <span><img src="/assets/autenticacao/linkedin.png" alt="LinkedIn"></span>
                <span><img src="/assets/autenticacao/facebook.png" alt="Facebook"></span>
                <span><img src="/assets/autenticacao/apple.png" alt="Apple"></span>
            </div>
            <% if (perfil === "cliente") { %>
                <a class="auth-switch" href="/prestador/cadastro"><%= etapa === "cadastro" ? "Cadastrar" : "Entrar" %> como prestador de serviço</a>
            <% } else { %>
                <a class="auth-switch" href="/cliente/<%= etapa %>"><%= etapa === "cadastro" ? "Cadastrar" : "Entrar" %> como Cliente<%= etapa === "entrar" ? "." : "" %></a>
            <% } %>
        </section>

        <footer class="auth-footer">
            <div class="auth-footer__divider"></div>
            <div class="auth-footer__legal">
                <p class="auth-footer__security">
                    <span class="auth-footer__lock" aria-hidden="true">
                        <span class="auth-footer__lock-shackle"></span>
                        <span class="auth-footer__lock-body"><img src="/assets/autenticacao/cadeado-rodape.svg" alt=""></span>
                    </span>
                    <span>Seus dados estão<br>seguros conosco.</span>
                </p>
                <nav class="auth-footer__links" aria-label="Links legais">
                    <a href="#termos">Termos</a>
                    <img src="/assets/autenticacao/ponto-rodape.svg" alt="" aria-hidden="true">
                    <a href="#privacidade">Privacidade</a>
                </nav>
            </div>
            <p class="auth-footer__copyright">© 2027 Steply</p>
        </footer>
    </main>

    <script>
        (function () {
            const cpfInput = document.querySelector('input[name="cpf"]');
            const telefoneInput = document.querySelector('input[name="telefone"]');
            const estadoInput = document.querySelector('input[name="estado"]');
            const bairroInput = document.querySelector('input[name="bairro"]');
            const cidadeInput = document.querySelector('input[name="cidade"]');
            const documentoInput = document.querySelector('input[name="documento"]');
            const nascimentoInput = document.querySelector('input[name="nascimento"]');
            const cepInput = document.querySelector('input[name="cep"]');
            const sugestoesBairros = document.getElementById('sugestoes-bairros');
            const sugestoesCidades = document.getElementById('sugestoes-cidades');
            const bairros = ["Centro", "Jardim América", "Jardim Bela Vista", "Vila Nova", "Zona Rural", "Boa Vista", "Santa Luzia", "São José", "São Lucas", "Nova Esperança", "Cidade Jardim", "Parque das Flores", "Jardim Paulista", "Bela Vista", "Liberdade"];
            const cidades = ["São Paulo", "Campinas", "Ribeirão Preto", "Sorocaba", "Santos", "Bauru", "Guarulhos", "São Bernardo do Campo", "Santo André", "Osasco", "Piracicaba", "Jundiaí", "Mogi das Cruzes", "Franca", "São José dos Campos", "Americana"];
            const estados = ["Acre", "Alagoas", "Amapá", "Amazonas", "Bahia", "Ceará", "Distrito Federal", "Espírito Santo", "Goiás", "Maranhão", "Mato Grosso", "Mato Grosso do Sul", "Minas Gerais", "Pará", "Paraíba", "Paraná", "Pernambuco", "Piauí", "Rio de Janeiro", "Rio Grande do Norte", "Rio Grande do Sul", "Rondônia", "Roraima", "Santa Catarina", "São Paulo", "Sergipe", "Tocantins"];

            function mostrarErro(input, mensagem) {
                if (!input) return;
                input.setAttribute("aria-invalid", mensagem ? "true" : "false");
                const campo = input.closest(".auth-field, .provider-field");
                if (!campo) return;

                let feedback = campo.querySelector(".auth-field-error--browser, .provider-field-error--browser");
                if (!feedback) {
                    feedback = document.createElement("small");
                    feedback.className = campo.classList.contains("provider-field")
                        ? "provider-field-error provider-field-error--browser"
                        : "auth-field-error auth-field-error--browser";
                    campo.appendChild(feedback);
                }
                feedback.textContent = mensagem || "";
                feedback.hidden = !mensagem;
            }

            if (cpfInput) {
                cpfInput.addEventListener("blur", function () {
                    const cpf = this.value.replace(/\D/g, "");
                    let valido = /^\d{11}$/.test(cpf) && !/^([\d])\1{10}$/.test(cpf);

                    if (valido) {
                        let soma = 0;
                        for (let i = 0; i < 9; i++) soma += Number(cpf[i]) * (10 - i);
                        let digito = (soma * 10) % 11;
                        if (digito === 10) digito = 0;
                        valido = digito === Number(cpf[9]);

                        if (valido) {
                            soma = 0;
                            for (let i = 0; i < 10; i++) soma += Number(cpf[i]) * (11 - i);
                            digito = (soma * 10) % 11;
                            if (digito === 10) digito = 0;
                            valido = digito === Number(cpf[10]);
                        }
                    }

                    mostrarErro(this, cpf && !valido ? "Informe um CPF válido." : "");
                });
            }

            if (telefoneInput) {
                telefoneInput.addEventListener("blur", function () {
                    const telefone = this.value.replace(/\D/g, "");
                    mostrarErro(this, telefone && !/^\d{10,11}$/.test(telefone) ? "Informe um telefone válido com 10 ou 11 dígitos." : "");
                });
            }

            function textoNormalizado(valor) {
                return valor.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
            }

            function configurarSugestoes(input, lista, opcoes) {
                if (!input || !lista) return;

                let indiceAtivo = -1;

                function fecharLista() {
                    lista.hidden = true;
                    indiceAtivo = -1;
                    input.setAttribute("aria-expanded", "false");
                    input.removeAttribute("aria-activedescendant");
                }

                function selecionar(valor) {
                    input.value = valor;
                    fecharLista();
                    input.focus();
                }

                function atualizarLista() {
                    const texto = textoNormalizado(input.value.trim());
                    if (!texto) {
                        fecharLista();
                        return;
                    }

                    const resultados = opcoes
                        .filter((opcao) => textoNormalizado(opcao).includes(texto))
                        .slice(0, 6);

                    lista.replaceChildren();
                    indiceAtivo = -1;

                    resultados.forEach((resultado, indice) => {
                        const item = document.createElement("li");
                        item.id = `${lista.id}-opcao-${indice}`;
                        item.className = "auth-suggestions__item";
                        item.setAttribute("role", "option");
                        item.textContent = resultado;
                        item.addEventListener("mousedown", (evento) => {
                            evento.preventDefault();
                            selecionar(resultado);
                        });
                        lista.appendChild(item);
                    });

                    lista.hidden = resultados.length === 0;
                    input.setAttribute("aria-expanded", resultados.length ? "true" : "false");
                }

                input.addEventListener("input", atualizarLista);
                input.addEventListener("focus", atualizarLista);
                input.addEventListener("keydown", (evento) => {
                    const itens = [...lista.querySelectorAll(".auth-suggestions__item")];
                    if (!itens.length) return;

                    if (evento.key === "ArrowDown" || evento.key === "ArrowUp") {
                        evento.preventDefault();
                        indiceAtivo = evento.key === "ArrowDown"
                            ? (indiceAtivo + 1) % itens.length
                            : (indiceAtivo - 1 + itens.length) % itens.length;
                        itens.forEach((item, indice) => item.classList.toggle("is-active", indice === indiceAtivo));
                        input.setAttribute("aria-activedescendant", itens[indiceAtivo].id);
                        itens[indiceAtivo].scrollIntoView({ block: "nearest" });
                    }

                    if (evento.key === "Enter" && indiceAtivo >= 0) {
                        evento.preventDefault();
                        selecionar(itens[indiceAtivo].textContent);
                    }

                    if (evento.key === "Escape") fecharLista();
                });

                input.addEventListener("blur", () => setTimeout(fecharLista, 120));
            }

            configurarSugestoes(bairroInput, sugestoesBairros, bairros);
            configurarSugestoes(cidadeInput, sugestoesCidades, cidades);

            document.querySelectorAll('input[name="estado"], input[name="bairro"], input[name="cidade"]').forEach((input) => {
                const lista = document.getElementById(`provider-sugestoes-${input.name}`);
                const opcoes = input.name === "estado" ? estados : input.name === "bairro" ? bairros : cidades;
                configurarSugestoes(input, lista, opcoes);
            });

            if (nascimentoInput) {
                nascimentoInput.addEventListener("input", function () {
                    const numeros = this.value.replace(/\D/g, "").slice(0, 8);
                    this.value = numeros.length > 4
                        ? `${numeros.slice(0, 2)}/${numeros.slice(2, 4)}/${numeros.slice(4)}`
                        : numeros.length > 2
                            ? `${numeros.slice(0, 2)}/${numeros.slice(2)}`
                            : numeros;
                });
            }

            if (cepInput) {
                cepInput.addEventListener("input", function () {
                    const numeros = this.value.replace(/\D/g, "").slice(0, 8);
                    this.value = numeros.length > 5 ? `${numeros.slice(0, 5)}-${numeros.slice(5)}` : numeros;
                });
            }

            if (documentoInput) {
                documentoInput.addEventListener("input", function () {
                    const numeros = this.value.replace(/\D/g, "").slice(0, 14);
                    this.value = numeros.length <= 11
                        ? numeros.replace(/(\d{3})(\d)/, "$1.$2").replace(/(\d{3})(\d)/, "$1.$2").replace(/(\d{3})(\d{1,2})$/, "$1-$2")
                        : numeros.replace(/(\d{2})(\d)/, "$1.$2").replace(/(\d{3})(\d)/, "$1.$2").replace(/(\d{3})(\d)/, "$1/$2").replace(/(\d{4})(\d)/, "$1-$2");
                });
            }

            function cpfValido(valor) {
                const cpf = valor.replace(/\D/g, "");
                if (!/^\d{11}$/.test(cpf) || /^([\d])\1{10}$/.test(cpf)) return false;

                let soma = 0;
                for (let i = 0; i < 9; i++) soma += Number(cpf[i]) * (10 - i);
                let digito = (soma * 10) % 11;
                if (digito === 10) digito = 0;
                if (digito !== Number(cpf[9])) return false;

                soma = 0;
                for (let i = 0; i < 10; i++) soma += Number(cpf[i]) * (11 - i);
                digito = (soma * 10) % 11;
                if (digito === 10) digito = 0;
                return digito === Number(cpf[10]);
            }

            function cnpjValido(valor) {
                const cnpj = valor.replace(/\D/g, "");
                if (!/^\d{14}$/.test(cnpj) || /^([\d])\1{13}$/.test(cnpj)) return false;
                const pesos1 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
                const pesos2 = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
                function calcular(base, pesos) {
                    let soma = 0;
                    base.forEach((numero, indice) => { soma += Number(numero) * pesos[indice]; });
                    const resto = soma % 11;
                    return resto < 2 ? 0 : 11 - resto;
                }
                return calcular(cnpj.slice(0, 12), pesos1) === Number(cnpj[12])
                    && calcular(cnpj.slice(0, 13), pesos2) === Number(cnpj[13]);
            }

            function dataValida(valor) {
                const match = valor.match(/^([0-9]{2})\/([0-9]{2})\/([0-9]{4})$/);
                if (!match) return false;
                const dia = Number(match[1]);
                const mes = Number(match[2]);
                const ano = Number(match[3]);
                const data = new Date(ano, mes - 1, dia);
                const hoje = new Date();
                hoje.setHours(0, 0, 0, 0);
                return data.getFullYear() === ano && data.getMonth() === mes - 1
                    && data.getDate() === dia && data <= hoje;
            }

            function validarCampo(input) {
                if (!input) return "";
                const nome = input.name;
                const valor = input.value.trim();

                if (input.required && !valor) {
                    if (nome === "email") return "Informe seu e-mail.";
                    if (nome === "senha") return "Informe sua senha.";
                    if (nome === "confirmar-senha") return "Confirme sua senha.";
                    return "Este campo é obrigatório.";
                }

                if (!valor) return "";

                if (nome === "email") {
                    const formularioCadastro = document.querySelector('input[name="confirmar-senha"]');
                    if (!formularioCadastro && valor.toLowerCase() === "steply") return "";
                    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(valor) ? "" : "Informe um e-mail válido ou o usuário steply.";
                }
                if (nome === "nome" && valor.split(/\s+/).length < 2) return "Informe seu nome completo.";
                if (nome === "cpf") return cpfValido(valor) ? "" : "Informe um CPF válido.";
                if (nome === "documento") {
                    const numeros = valor.replace(/\D/g, "");
                    const valido = numeros.length === 11 ? cpfValido(numeros) : numeros.length === 14 ? cnpjValido(numeros) : false;
                    return valido ? "" : "Informe um CPF ou CNPJ válido.";
                }
                if (nome === "nascimento") return dataValida(valor) ? "" : "Informe uma data de nascimento válida.";
                if (nome === "cep") return /^\d{5}-?\d{3}$/.test(valor) ? "" : "Informe um CEP válido.";
                if (nome === "telefone") {
                    const numeros = valor.replace(/\D/g, "");
                    return /^\d{10,11}$/.test(numeros) ? "" : "Informe um telefone válido com 10 ou 11 dígitos.";
                }
                if (nome === "senha" && valor.length < 8) {
                    const formularioCadastro = document.querySelector('input[name="confirmar-senha"]');
                    return !formularioCadastro && valor === "2027" ? "" : "A senha deve ter pelo menos 8 caracteres.";
                }
                if (nome === "confirmar-senha") {
                    const senha = document.querySelector('input[name="senha"]');
                    return senha && valor === senha.value ? "" : "As senhas não coincidem.";
                }
                if (nome === "numero" && !/^\d{1,10}$|^S\/N$/i.test(valor)) return "Informe um número válido.";
                return "";
            }

            const formAuth = document.querySelector(".auth-form");
            if (formAuth) {
                const camposAuth = [...formAuth.querySelectorAll("input:not([type='file'])")];

                camposAuth.forEach((input) => {
                    input.addEventListener("blur", () => mostrarErro(input, validarCampo(input)));
                    input.addEventListener("input", () => {
                        if (input.getAttribute("aria-invalid") === "true") {
                            mostrarErro(input, validarCampo(input));
                        }
                    });
                });

                formAuth.addEventListener("submit", (evento) => {
                    let primeiroInvalido = null;
                    camposAuth.forEach((input) => {
                        const mensagem = validarCampo(input);
                        mostrarErro(input, mensagem);
                        if (mensagem && !primeiroInvalido) primeiroInvalido = input;
                    });

                    if (primeiroInvalido) {
                        evento.preventDefault();
                        primeiroInvalido.focus();
                        primeiroInvalido.scrollIntoView({ behavior: "smooth", block: "center" });
                    }
                });
            }
        }());
    </script>
</body>
</html>
